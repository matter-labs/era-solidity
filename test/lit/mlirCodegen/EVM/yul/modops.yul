// RUN: solc --strict-assembly --mlir-action=print-std-mlir --mlir-target=evm --mmlir --mlir-print-debuginfo %s | FileCheck %s

object "Test" {
  code {
    let x := mload(0)
    let y := mload(32)
    let m := mload(64)
    mstore(0, addmod(x, y, m))
    mstore(32, mulmod(x, y, m))
    return(0, 64)
  }
}
