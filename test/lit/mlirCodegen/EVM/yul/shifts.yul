// RUN: solc --strict-assembly --mlir-action=print-std-mlir --mlir-target=evm --mmlir --mlir-print-debuginfo %s | FileCheck %s

object "Test" {
  code {
    let a := mload(0)
    let b := mload(32)
    mstore(64, shl(a, b))
    mstore(96, shr(a, b))
    mstore(128, sar(a, b))
    return(64, 96)
  }
}
