// RUN: solc --strict-assembly --mlir-action=print-init --mmlir --mlir-print-debuginfo %s | FileCheck %s

object "Test" {
  code {
    let a := mload(0)
    let b := mload(32)
    mstore(64, div(a, b))
    mstore(96, sdiv(a, b))
    mstore(128, mod(a, b))
    mstore(160, smod(a, b))
    return(64, 128)
  }
}
