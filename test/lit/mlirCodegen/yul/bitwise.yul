// RUN: solc --strict-assembly --mlir-action=print-init --mmlir --mlir-print-debuginfo %s | FileCheck %s

object "Test" {
  code {
    let a := mload(0)
    let b := mload(32)
    mstore(64, and(a, b))
    mstore(96, or(a, b))
    mstore(128, xor(a, b))
  }
}
