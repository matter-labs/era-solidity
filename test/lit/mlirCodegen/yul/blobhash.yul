// CHECK-NEXT:     %c0_i256_0 = arith.constant 0 : i256 loc(#loc5)
// CHECK-NEXT:     %c32_i256 = arith.constant 32 : i256 loc(#loc6)
// CHECK-NEXT:     yul.return %c0_i256_0, %c32_i256 loc(#loc7)
